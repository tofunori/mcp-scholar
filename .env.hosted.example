# Hosted multi-user Scholar. Copy to .env.hosted and fill in.
# Do NOT put your own OpenAlex/S2/Scopus/SciX/CORE keys here: in hosted mode
# every user brings their own keys from the /keys page.

# google or github
SCHOLAR_AUTH=google
SCHOLAR_OAUTH_CLIENT_ID=
SCHOLAR_OAUTH_CLIENT_SECRET=

# Public URL of the server, without trailing slash or /mcp
SCHOLAR_BASE_URL=https://scholar.example.org

# Long random string; generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and makes stored keys unreadable.
SCHOLAR_SECRET_KEY=

# Who may sign in (comma-separated). SCHOLAR_ALLOWED_EMAILS=* lets anyone in.
SCHOLAR_ALLOWED_DOMAINS=
SCHOLAR_ALLOWED_EMAILS=
SCHOLAR_ALLOWED_GITHUB_USERS=

# Contact email sent to Crossref and Europe PMC (polite pool)
OPENALEX_MAILTO=
